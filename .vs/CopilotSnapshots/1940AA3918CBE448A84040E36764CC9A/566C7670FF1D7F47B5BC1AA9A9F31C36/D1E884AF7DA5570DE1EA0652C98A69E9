@using BioLife.Domain.Entities
@model List<AppUser>

<div class="container-fluid">
    <h1 class="h3 mb-2 text-gray-800">İstifadəçilər</h1>
    <p class="mb-4">Sistemdə qeydiyyatdan keçmiş bütün şəxslərin siyahısı.</p>

    <div class="card shadow mb-4">
        <div class="card-header py-3">
            <h6 class="m-0 font-weight-bold text-primary">İstifadəçi Siyahısı</h6>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered" id="dataTable" width="100%" cellspacing="0">
                    <thead>
                        <tr>
                            <th>Ad Soyad</th>
                            <th>Email</th>
                            <th>Qeydiyyat Tarixi</th>
                            <th>Status</th>
                            <th>Əməliyyatlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.FullName</td>
                                <td>@user.Email</td>
                                <td>@user.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="badge badge-success">Aktiv</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Deaktiv</span>
                                    }
                                </td>
                                <td>
                                    <form asp-action="Delete" asp-route-id="@user.Id" method="post" onsubmit="return confirm('Bu istifadəçini silmək istədiyinizə əminsiniz?');">
                                        <button type="submit" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i> Sil
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>