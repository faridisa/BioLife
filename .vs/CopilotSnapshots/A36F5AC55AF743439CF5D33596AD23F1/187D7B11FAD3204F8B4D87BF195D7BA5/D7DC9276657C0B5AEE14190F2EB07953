@model BioLife.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="login-page">
    <div class="login-card">
        <div class="login-panel login-form-panel">
            <div class="panel-header">
                <span class="panel-badge">login.page</span>
                <h3>Giriş Yap</h3>
                <p>Və ya e-poçt şifrənizi istifadə edin</p>
            </div>
            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Email"></label>
                    <input asp-for="Email" class="form-control" placeholder="E-mail" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Password"></label>
                    <input asp-for="Password" class="form-control" placeholder="Şifrə" />
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="form-group form-row">
                    <label class="checkbox">
                        <input asp-for="RememberMe" /> Yadda saxla
                    </label>
                    <a asp-action="Register" class="link-to">Şifrəmi unutdum?</a>
                </div>
                <div class="form-group">
                    <button type="submit" class="btn btn-bold btn-block">GİRİŞ</button>
                </div>
            </form>
        </div>
        <div class="login-panel login-side-panel">
            <div class="side-content">
                <h3>Merhaba, Dəyərli Üyə!</h3>
                <p>Sistemin bütün özəlliklərini istifadə etmək üçün qeydiyyatdan keçin.</p>
                <a asp-action="Register" class="btn btn-thin btn-outline">KAYIT OL</a>
            </div>
        </div>
    </div>
</div>

<style type="text/css">
    .login-page {
        min-height: 70vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #4a1fb8 0%, #6a1bc1 100%);
        padding: 60px 20px;
    }
    .login-card {
        width: 100%;
        max-width: 980px;
        background: #fff;
        border-radius: 18px;
        display: grid;
        grid-template-columns: 1.1fr 1fr;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.2);
        overflow: hidden;
    }
    .login-panel {
        padding: 48px;
    }
    .login-form-panel .panel-header h3 {
        margin: 10px 0 6px;
        font-weight: 700;
    }
    .login-form-panel .panel-header p {
        color: #6b6b6b;
        margin-bottom: 24px;
    }
    .panel-badge {
        color: #7a51d5;
        font-weight: 600;
        font-size: 14px;
    }
    .login-form-panel .form-group {
        margin-bottom: 18px;
    }
    .login-form-panel .form-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 14px;
    }
    .login-form-panel .btn-block {
        width: 100%;
    }
    .login-side-panel {
        background: #5a2bc0;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .login-side-panel .side-content {
        text-align: center;
        max-width: 320px;
    }
    .login-side-panel h3 {
        font-weight: 700;
        margin-bottom: 12px;
    }
    .login-side-panel p {
        opacity: 0.85;
        margin-bottom: 24px;
    }
    .btn-outline {
        border: 1px solid #fff;
        color: #fff;
        padding: 10px 26px;
        display: inline-block;
    }
    @media (max-width: 900px) {
        .login-card {
            grid-template-columns: 1fr;
        }
        .login-side-panel {
            order: -1;
        }
    }
</style>
