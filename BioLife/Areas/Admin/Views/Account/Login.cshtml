@model BioLife.Models.LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <title>Admin Panel - Giriş</title>

    <link href="~/AdminPanel/vendor/fontawesome-free/css/all.min.css" rel="stylesheet" type="text/css">
    <link href="https://fonts.googleapis.com/css?family=Nunito:200,200i,300,300i,400,400i,600,600i,700,700i,800,800i,900,900i" rel="stylesheet">
    <link href="~/AdminPanel/css/sb-admin-2.min.css" rel="stylesheet">
</head>

<body class="bg-gradient-primary">
    <div class="container">
        <!-- Outer Row -->
        <div class="row justify-content-center">
            <div class="col-xl-6 col-lg-8 col-md-9" style="margin-top:10%">
                <div class="card o-hidden border-0 shadow-lg my-5">
                    <div class="card-body p-0">
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="p-5">
                                    <div class="text-center">
                                        <h1 class="h4 text-gray-900 mb-4">Admin Panelə Giriş</h1>
                                    </div>
                                    <form class="user" asp-action="Login" asp-controller="Account" asp-area="Admin" method="post">
                                        <div asp-validation-summary="All" class="text-danger small mb-3"></div>
                                        <div class="form-group">
                                            <input asp-for="Email" type="email" class="form-control form-control-user" placeholder="Email ünvanınızı daxil edin..." required>
                                        </div>
                                        <div class="form-group">
                                            <input asp-for="Password" type="password" class="form-control form-control-user" placeholder="Şifrəniz" required>
                                        </div>
                                        <div class="form-group">
                                            <div class="custom-control custom-checkbox small">
                                                <input asp-for="RememberMe" type="checkbox" class="custom-control-input" id="customCheck">
                                                <label class="custom-control-label" for="customCheck">Məni xatırla</label>
                                            </div>
                                        </div>
                                        <button type="submit" class="btn btn-primary btn-user btn-block">
                                            Daxil ol
                                        </button>
                                    </form>
                                    <hr>
                                    <div class="text-center">
                                        <a class="small" href="/">Ana Səhifəyə Qayıt</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="~/AdminPanel/vendor/jquery/jquery.min.js"></script>
    <script src="~/AdminPanel/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/AdminPanel/vendor/jquery-easing/jquery.easing.min.js"></script>
    <script src="~/AdminPanel/js/sb-admin-2.min.js"></script>
</body>
</html>
