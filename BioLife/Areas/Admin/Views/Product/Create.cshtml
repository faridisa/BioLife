@{
    ViewBag.Title = "Yeni Məhsul";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";
}

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Yeni Məhsul</h1>
    <a href="/Admin/Product" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-left"></i> Geri
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-body">
        <form method="post" action="/Admin/Product/Create" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label>Şəkil</label>
    
                <!-- Tab seçimi -->
                <div class="mb-2">
                    <div class="btn-group btn-group-sm" role="group">
                        <button type="button" class="btn btn-outline-primary active"
                                onclick="switchTab('file')">
                            <i class="fas fa-upload"></i> Fayl yüklə
                        </button>
                        <button type="button" class="btn btn-outline-primary"
                                onclick="switchTab('url')">
                            <i class="fas fa-link"></i> URL ilə
                        </button>
                    </div>
                </div>

                <!-- Fayl yükləmə -->
                <div id="fileTab">
                    <div class="custom-file">
                        <input type="file" class="custom-file-input" id="ImageFile"
                               name="ImageFile" accept="image/*"
                               onchange="previewImage(this)">
                        <label class="custom-file-label" for="ImageFile">Fayl seçin...</label>
                    </div>
                </div>

                <!-- URL ilə -->
                <div id="urlTab" style="display:none;">
                    <input type="text" name="ImageUrl" id="ImageUrl"
                           class="form-control" placeholder="https://example.com/image.jpg"
                           oninput="previewUrl(this.value)">
                </div>

                <!-- Önizləmə -->
                <div class="mt-2" id="imagePreviewBox" style="display:none;">
                    <img id="imagePreview" src="#" alt="Önizləmə"
                         class="img-thumbnail" style="max-height:180px;" />
                </div>
            </div>
            <div class="form-group">
                <label>Ad</label>
                <input type="text" name="Name" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Açıqlama</label>
                <textarea name="Description" class="form-control" rows="3"></textarea>
            </div>

            <div class="form-group">
                <label>Qiymət (AZN)</label>
                <input type="number" name="Price" class="form-control" step="0.01" required />
            </div>

            <div class="form-group">
                <label>Stok</label>
                <input type="number" name="Stock" class="form-control" required />
            </div>

            <div class="form-group">
                <label>Şəkil</label>
                <input type="file" name="ImageFile" class="form-control-file" accept="image/*" />
            </div>

            <div class="form-group">
                <label>Status</label>
                <select name="IsActive" class="form-control">
                    <option value="true">Aktiv</option>
                    <option value="false">Deaktiv</option>
                </select>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> Yadda Saxla
            </button>
        </form>
    </div>
</div>
<style>
    @section Scripts {
    <script>
        function switchTab(tab) {
            const fileTab = document.getElementById('fileTab');
            const urlTab = document.getElementById('urlTab');
            const btns = document.querySelectorAll('.btn-group .btn');

            if (tab === 'file') {
                fileTab.style.display = 'block';
                urlTab.style.display = 'none';
                // URL inputu təmizlə
                document.getElementById('ImageUrl').value = '';
                btns[0].classList.add('active');
                btns[1].classList.remove('active');
            } else {
                fileTab.style.display = 'none';
                urlTab.style.display = 'block';
                btns[0].classList.remove('active');
                btns[1].classList.add('active');
            }

            // Önizləməni gizlət
            document.getElementById('imagePreviewBox').style.display = 'none';
        }

        function previewImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = e => {
                    document.getElementById('imagePreview').src = e.target.result;
                    document.getElementById('imagePreviewBox').style.display = 'block';
                };
                reader.readAsDataURL(input.files[0]);
                // Label yenilə
                input.nextElementSibling.textContent = input.files[0].name;
            }
        }

        function previewUrl(url) {
            if (url.trim() !== '') {
                document.getElementById('imagePreview').src = url;
                document.getElementById('imagePreviewBox').style.display = 'block';
            } else {
                document.getElementById('imagePreviewBox').style.display = 'none';
            }
        }
    </script>
}
</style>