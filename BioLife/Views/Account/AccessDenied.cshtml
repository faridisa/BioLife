@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Giriş qadağandır</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body { background-color: #f4f7f6; display: flex; align-items: center; justify-content: center; height: 100vh; text-align: center; }
        .error-card { max-width: 500px; padding: 40px; background: #fff; border-radius: 15px; box-shadow: 0 10px 25px rgba(0,0,0,0.1); }
    </style>
</head>
<body>

<div class="error-card">
    <h1 class="text-danger mb-3">403</h1>
    <h3 class="mb-3">Giriş qadağandır</h3>
    <p class="text-muted mb-4">Sizin bu səhifəyə daxil olmaq üçün icazəniz yoxdur. Admin panelinə yalnız Admin rolu olan istifadəçilər girə bilər.</p>
    <a href="/" class="btn btn-success">Ana səhifəyə qayıt</a>
</div>

</body>
</html>
